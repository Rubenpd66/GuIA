{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run validate:content)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(graphify query *)",
      "Bash(graphify update .)",
      "PowerShell(npm run check)",
      "PowerShell(npm run validate:content)",
      "PowerShell(npx vitest run *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
