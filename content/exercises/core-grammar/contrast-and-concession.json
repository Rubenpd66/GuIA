    {
      "id": "cg-contrast-and-concession-02",
      "examPart": "core-grammar",
      "cefrLevel": "B2",
      "topic": "media",
      "difficulty": 2,
      "register": "spoken",
      "grammarPoint": "contrast-and-concession",
      "prompt": "A: Was the film any good? B: The acting was great. ___, the plot was really weak.",
      "options": ["Although", "However", "Despite"],
      "answer": 1,
      "explanation": {
        "en": "However starts a new sentence to show contrast."
      },
      "optionNotes": [
        {
          "en": "Although would join two clauses and not start a sentence this way."
        },
        {
          "en": "Correct: However plus a comma."
        },
        {
          "en": "Despite needs a noun or -ing."
        }
      ]
    },
    {
