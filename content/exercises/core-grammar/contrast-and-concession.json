      "grammarPoint": "contrast-and-concession",
      "prompt": "___ the late train, he arrived at the meeting on time.",
      "options": ["Despite", "Although", "However"],
      "answer": 0,
      "explanation": {
        "en": "Despite is followed by a noun phrase."
      },
      "optionNotes": [
        {
          "en": "Correct: despite + noun phrase."
        },
        {
          "en": "Although needs a full clause."
        },
        {
          "en": "However starts a new sentence and needs a comma."
        }
      ]
