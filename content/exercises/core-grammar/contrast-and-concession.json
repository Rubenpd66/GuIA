      "grammarPoint": "contrast-and-concession",
      "prompt": "She passed the exam ___ she had hardly studied.",
      "options": ["despite", "however", "even though"],
      "answer": 2,
      "explanation": {
        "en": "A full clause follows, so even though is needed.",
