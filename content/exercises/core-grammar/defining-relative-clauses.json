      "topic": "work",
      "difficulty": 1,
      "register": "written",
      "grammarPoint": "defining-relative-clauses",
      "prompt": "The colleague ___ sits opposite me is from Poland.",
      "options": ["who", "which", "whose"],
      "answer": 0,
      "explanation": {
        "en": "Who refers to a person and is the subject of sits."
      },
      "optionNotes": [
        {
          "en": "Correct: who for a person as subject."
        },
        {
          "en": "Which is for things, not people."
        },
        {
          "en": "Whose shows possession, but nothing belongs to the colleague here."
        }
      ]
    },
    {
      "id": "cg-defining-relative-clauses-02",
      "examPart": "core-grammar",
      "cefrLevel": "B1",
      "topic": "technology",
      "difficulty": 2,
      "register": "written",
      "grammarPoint": "defining-relative-clauses",
      "prompt": "The software ___ the company bought last year keeps crashing.",
      "options": ["who", "which", "whose"],
      "answer": 1,
      "explanation": {
        "en": "Which refers to a thing.",
        "es": "No uses who para cosas."
      },
      "optionNotes": [
        {
          "en": "Who is for people."
        },
        {
          "en": "Correct: which for a thing."
        },
        {
          "en": "Whose would need a possessed noun, such as whose price."
        }
      ]
    },
    {
      "id": "cg-defining-relative-clauses-03",
      "examPart": "core-grammar",
      "cefrLevel": "B1",
      "topic": "relationships",
      "difficulty": 3,
      "register": "spoken",
      "grammarPoint": "defining-relative-clauses",
      "prompt": "A: Who's Dani? B: He's the guy ___ sister I went to school with.",
      "options": ["who", "that", "whose"],
      "answer": 2,
      "explanation": {
        "en": "Whose shows possession: his sister.",
        "es": "«Cuyo/a» = whose."
      },
      "optionNotes": [
        {
          "en": "Who would need a verb next, not a noun."
        },
        {
          "en": "That cannot show possession."
        },
        {
          "en": "Correct: whose means of whom."
        }
      ]
    },
