      "topic": "shopping-consumption",
      "difficulty": 4,
      "register": "written",
      "grammarPoint": "condition-and-purpose-linkers",
      "prompt": "You won't get a refund ___ you have the receipt.",
      "options": ["unless", "as long as", "in case"],
      "answer": 0,
      "explanation": {
        "en": "Unless means if not.",
        "es": "Unless ya significa «si no»."
