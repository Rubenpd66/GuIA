        }
      ]
    },
    {
      "id": "cg-condition-and-purpose-linkers-05",
      "examPart": "core-grammar",
      "cefrLevel": "B2",
      "topic": "technology",
      "difficulty": 5,
      "register": "written",
      "grammarPoint": "condition-and-purpose-linkers",
      "prompt": "He turned off notifications ___ not to be distracted while studying.",
      "options": ["so that", "so as", "for"],
      "answer": 1,
      "explanation": {
        "en": "So as not to + infinitive.",
        "es": "So as not to, nunca so that not to."
      },
      "optionNotes": [
        {
          "en": "So that is followed by a clause, not by not to."
        },
        {
          "en": "Correct: so as not to."
        },
        {
          "en": "For does not combine with not to."
        }
      ]
    }
