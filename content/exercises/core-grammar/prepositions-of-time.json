  "kind": "exercises",
  "items": [
    {
      "id": "cg-prepositions-of-time-01",
      "examPart": "core-grammar",
      "cefrLevel": "A2",
      "topic": "work",
      "difficulty": 1,
      "register": "written",
      "grammarPoint": "prepositions-of-time",
      "prompt": "Our weekly team meeting is ___ Tuesdays.",
      "options": ["at", "on", "in"],
      "answer": 1,
      "explanation": {
        "en": "Days of the week take on.",
        "es": "«Los martes» = on Tuesdays."
      },
      "optionNotes": [
        {
          "en": "At is for clock times and fixed expressions such as at night."
        },
        {
          "en": "Correct: on + day of the week."
        },
        {
          "en": "In is for months, years and parts of the day."
        }
      ]
    },
    {
      "id": "cg-prepositions-of-time-02",
      "examPart": "core-grammar",
      "cefrLevel": "A2",
      "topic": "general",
      "difficulty": 2,
      "register": "spoken",
      "grammarPoint": "prepositions-of-time",
      "prompt": "I never answer my phone ___ night.",
      "options": ["in", "at", "on"],
      "answer": 1,
      "explanation": {
        "en": "At night is a fixed expression."
      },
      "optionNotes": [
        {
          "en": "In night is not used; in the night means something different."
        },
        {
          "en": "Correct: at night."
        },
        {
          "en": "On is for days and dates."
        }
      ]
    },
    {
      "id": "cg-prepositions-of-time-03",
      "examPart": "core-grammar",
      "cefrLevel": "A2",
      "topic": "education",
      "difficulty": 2,
      "register": "written",
      "grammarPoint": "prepositions-of-time",
      "prompt": "The university was founded ___ 1888.",
      "options": ["on", "at", "in"],
      "answer": 2,
      "explanation": {
        "en": "Years take in."
      },
      "optionNotes": [
        {
          "en": "On is for days and dates."
        },
        {
          "en": "At is for clock times."
        },
        {
          "en": "Correct: in + year."
        }
      ]
    },
    {
      "id": "cg-prepositions-of-time-04",
      "examPart": "core-grammar",
      "cefrLevel": "A2",
      "topic": "travel",
      "difficulty": 3,
      "register": "spoken",
      "grammarPoint": "prepositions-of-time",
      "prompt": "My train leaves ___ twenty minutes, so I have to go.",
      "options": ["in", "on", "at"],
      "answer": 0,
      "explanation": {
        "en": "In + a period of time means after that time from now.",
        "es": "«Dentro de veinte minutos» = in twenty minutes."
      },
      "optionNotes": [
        {
          "en": "Correct: in twenty minutes = twenty minutes from now."
        },
        {
          "en": "On is not used with a period of time."
        },
        {
          "en": "At is used for a clock time, not a length of time."
        }
      ]
    },
    {
      "id": "cg-prepositions-of-time-05",
      "examPart": "core-grammar",
      "cefrLevel": "A2",
      "topic": "shopping-consumption",
      "difficulty": 3,
      "register": "written",
      "grammarPoint": "prepositions-of-time",
      "prompt": "I'm going to buy a new phone ___ year.",
      "options": ["next", "in next", "at next"],
      "answer": 0,
      "explanation": {
        "en": "Next, last, this and every are used without a preposition.",
        "es": "«El año que viene» = next year, sin preposición."
      },
      "optionNotes": [
        {
          "en": "Correct: no preposition before next."
        },
        {
          "en": "In next is not used."
        },
        {
          "en": "At next is not used."
        }
      ]
    }
  ]
}
