        },
        {
          "prompt": "Which season do you like best for hiking?",
          "sampleAnswers": ["Autumn", "In the spring"]
        },
        {
          "prompt": "Who do you usually walk with?",
          "sampleAnswers": ["My dog", "Two friends from work"]
        },
        {
          "prompt": "Where would you like to go next?",
          "sampleAnswers": ["The Pyrenees", "Somewhere near the sea"]
        }
      ]
