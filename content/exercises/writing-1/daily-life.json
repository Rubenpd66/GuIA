      "examPart": "writing-1",
      "cefrLevel": "B1",
      "topic": "travel",
      "difficulty": 1,
      "context": "You are joining an online community for travellers. Answer the questions.",
      "messages": [
        {
          "prompt": "Where do you live?",
          "sampleAnswers": ["Valencia", "In a small town"]
        },
        {
          "prompt": "How do you usually travel on holiday?",
          "sampleAnswers": ["By train", "By car with friends"]
        },
        {
          "prompt": "What do you always take in your bag?",
          "sampleAnswers": ["My camera", "A good book"]
        },
        {
          "prompt": "Do you prefer cities or villages?",
          "sampleAnswers": ["Cities", "Small villages"]
        },
        {
          "prompt": "Where are you going this year?",
          "sampleAnswers": ["To Scotland", "I haven't decided yet"]
        }
      ]
    },
