      "difficulty": 2,
      "vocabType": "synonym",
      "instructions": "Choose the word that is closest in meaning to the word on the left.",
      "options": [
        "waste",
        "conserve",
        "toxic",
        "damage",
        "environment",
        "recycle",
        "flood",
        "fuel",
        "species",
        "emissions"
      ],
      "items": [
        {
          "id": "cv-environment-synonyms-01-a",
          "prompt": "rubbish",
          "answer": 0,
          "explanation": {
            "en": "Rubbish is the everyday British word; waste is the more general word for things we throw away."
          }
        },
        {
          "id": "cv-environment-synonyms-01-b",
          "prompt": "protect",
          "answer": 1,
          "explanation": {
            "en": "To conserve nature or energy is to protect it and use it carefully."
          }
        },
        {
          "id": "cv-environment-synonyms-01-c",
          "prompt": "poisonous",
          "answer": 2,
          "explanation": {
            "en": "Toxic substances are poisonous and can harm people or animals."
          }
        },
        {
          "id": "cv-environment-synonyms-01-d",
          "prompt": "harm",
          "answer": 3,
          "explanation": {
            "en": "To damage the planet is to harm it."
          }
        },
        {
          "id": "cv-environment-synonyms-01-e",
          "prompt": "surroundings",
          "answer": 4,
          "explanation": {
            "en": "The environment is the natural world, or the place around us in which we live."
          }
        }
      ]
    },
